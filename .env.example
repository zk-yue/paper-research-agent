# Reuse the saved local Codex CLI login (run `codex login` first).
LLM_PROVIDER=codex
CODEX_CLI_PATH=codex
CODEX_TIMEOUT=300
# Optional; blank uses the CLI's built-in default model, not OPENAI_MODEL.
CODEX_MODEL=
# Optional reasoning effort; model support varies.
CODEX_REASONING_EFFORT=medium

# Alternative backend: set LLM_PROVIDER=openai and supply an API key.
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=your-model

# Local server (single user / single worker).
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional independent runtime-data directory. Existing files are not moved.
# PAPER_RESEARCH_DATA_DIR=/absolute/path/to/research-data

# Optional OpenAlex key; anonymous API access has a shared daily quota.
# OPENALEX_API_KEY=
